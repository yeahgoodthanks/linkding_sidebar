{
  "manifest_version": 3,
  "name": "Linkding Bookmarks",
  "version": "1.0.0",
  "author": "@yeahgoodthanks on GitHub",
  "description": "A dropdown for your Linkding bookmarks, sorted by tags.",
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "sidePanel",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["http://*/", "https://*/"],
  "action": {
    "default_icon": {
      "16": "icons/favicon16.png",
      "48": "icons/favicon48.png",
      "128": "icons/favicon128.png"
    }
  },
  "icons": {
    "16": "icons/favicon16.png",
    "48": "icons/favicon48.png",
    "128": "icons/favicon128.png"
  },
  "options_page": "options.html",

  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "sidebar_action": {
    "default_panel": "side_panel.html",
    "default_title": "LinkDing",
    "default_icon": "icons/favicon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linkding@yeahgoodthanks",
      "strict_min_version": "58.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
